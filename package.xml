<?xml version="1.0"?>
<package format="3">
  <name>armchaos</name>
  <version>0.2.0</version>
  <description>Break a ros2_control arm on purpose (frozen, late, noisy, NaN or spoofed joint states, a deactivated controller) and restore it.</description>
  <maintainer email="darshmenon02@gmail.com">darshmenon</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
